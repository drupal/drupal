{
    "version": "0.2",
    "language": "en-US",
    "allowCompoundWords": false,
    "globRoot": ".",
    "ignorePaths": [
      "**/LICENSE.txt",
      "../composer/Metapackage/CoreRecommended/composer.json",
      "../composer/Metapackage/DevDependencies/composer.json",
      "../composer/Plugin/VendorHardening/Config.php",
      ".cspell.json",
      ".deprecation-ignore.txt",
      ".env.example",
      ".gitignore",
      ".phpstan-baseline.php",
      ".prettierignore",
      ".stylelintrc.json",
      "COPYRIGHT.txt",
      "MAINTAINERS.txt",
      "assets/vendor/**",
      "lib/Drupal/Component/Diff/**",
      "lib/Drupal/Component/Transliteration/data/**",
      "misc/jquery.form.js",
      "modules/**/Migrate*Test.php",
      "modules/ckeditor5/js/build/*",
      "modules/media/tests/fixtures/oembed/*",
      "node_modules/*",
      "package.json",
      "phpstan*",
      "profiles/demo_umami/modules/demo_umami_content/default_content/languages/es/**/*",
      "tests/Drupal/Tests/Component/Annotation/Doctrine/**",
      "tests/Drupal/Tests/Composer/Plugin/Scaffold/fixtures/drupal-assets-fixture/assets/.csslintrc",
      "tests/fixtures/config_install/*",
      "tests/fixtures/phpunit_*.xml"
    ],
    "ignoreRegExpList": [
      "!!binary .*",
      "%[0-9][0-9A-F]",
      "\\Wi18n",
      "\\x{[0-9A-F]{4,5}}",
      "^msgstr .*"
    ],
    "dictionaries": [
      "companies",
      "dictionary",
      "drupal",
      "fonts",
      "html",
      "php",
      "softwareTerms"
    ],
    "dictionaryDefinitions": [
      {
        "name": "dictionary",
        "path": "./misc/cspell/dictionary.txt"
      },
      {
        "name": "drupal",
        "path": "./misc/cspell/drupal-dictionary.txt"
      },
     ],
    "flagWords": [
      "blacklist",
      "blacklisted",
      "e-mail",
      "grey",
      "hte",
      "illegal",
      "ist",
      "please",
      "queuing",
      "sorry",
      "whitelist",
      "whitelisted",
      "writeable"
    ],
    "overrides": [
      {
        "filename": "**/{*.engine,*.inc,*.install,*.module,*.profile,*.theme}",
        "languageId": "php"
      },
      {
        "filename": "**/scripts/{*.php.txt, *.sh}",
        "languageId": "php"
      }
    ]
}
