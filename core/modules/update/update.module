/**
 * Returns a warning message when there is no data about available updates.
 *
 * @deprecated in drupal:11.5.0 and is removed from drupal:13.0.0. Use
 *   \Drupal\update\UpdateMessageTrait::noData() instead.
 *
 * @see https://www.drupal.org/node/3592959
 */
function _update_no_data() {
  @trigger_error(__FUNCTION__ . '() is deprecated in drupal:11.5.0 and is removed from drupal:13.0.0. Use \Drupal\update\UpdateMessageTrait::noData() instead. See https://www.drupal.org/node/3592959', E_USER_DEPRECATED);
  $destination = \Drupal::destination()->getAsArray();
  return t('No update information available. <a href=":run_cron">Run cron</a> or <a href=":check_manually">check manually</a>.', [
    ':run_cron' => Url::fromRoute('system.run_cron', [], ['query' => $destination])->toString(),
    ':check_manually' => Url::fromRoute('update.manual_status', [], ['query' => $destination])->toString(),
  ]);
}

/**
 * Tries to get update information and refreshes it when necessary.
 *
 * In addition to checking the lifetime, this function also ensures that there
 * are no .info.yml files for installed modules or themes that have a newer
 * modification timestamp than the last time we checked for available update
 * data. If any .info.yml file was modified, it almost certainly means a new
 * version of something was installed. Without fresh available update data, the
 * logic in \Drupal\update\UpdateManagerInterface::calculateProjectData() will
 * be wrong and produce confusing, bogus results.
 *
 * @param bool $refresh
 *   (optional) Boolean to indicate if this method should refresh automatically
 *   if there's no data. Defaults to FALSE.
 *
 * @return array
 *   Array of data about available releases, keyed by project shortname.
 *
 * @see \Drupal\update\UpdateManagerInterface::refreshUpdateData()
 * @see \Drupal\update\UpdateManagerInterface::getProjects()
 *
 * @deprecated in drupal:11.5.0 and is removed from drupal:13.0.0. Use
 *   \Drupal\update\UpdateManagerInterface::getAvailable() instead.
 *
 * @see https://www.drupal.org/node/3592959
 */
function update_get_available($refresh = FALSE) {
  @trigger_error(__FUNCTION__ . '() is deprecated in drupal:11.5.0 and is removed from drupal:13.0.0. Use \Drupal\update\UpdateManagerInterface::getAvailable() instead. See https://www.drupal.org/node/3592959', E_USER_DEPRECATED);
  return \Drupal::service(UpdateManagerInterface::class)->getAvailable($refresh);
}

/**
 * Adds a task to the queue for fetching release history data for a project.
 *
 * We only create a new fetch task if there's no task already in the queue for
 * this particular project (based on 'update_fetch_task' key-value collection).
 *
 * @param array $project
 *   Associative array of information about a project as created by
 *   \Drupal\update\UpdateManagerInterface::getProjects(), including keys such
 *   as 'name' (short name), and the 'info' array with data from a .info.yml
 *   file for the project.
 *
 * @see \Drupal\update\UpdateFetcher::createFetchTask()
 *
 * @deprecated in drupal:11.5.0 and is removed from drupal:13.0.0. Use
 *   \Drupal\update\UpdateProcessor::createFetchTask() instead.
 *
 * @see https://www.drupal.org/node/3592959
 */
function update_create_fetch_task($project): void {
  @trigger_error(__FUNCTION__ . '() is deprecated in drupal:11.5.0 and is removed from drupal:13.0.0. Use \Drupal\update\UpdateProcessor::createFetchTask() instead. See https://www.drupal.org/node/3592959', E_USER_DEPRECATED);
  \Drupal::service('update.processor')->createFetchTask($project);
}

